# Copy to .env.local for local development; set these in Vercel for deployment.
# Use the public Render API URL in production. Do not include a trailing slash.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Optional at local development; REQUIRED for correct production SEO/sitemap generation.
VITE_SITE_URL=
